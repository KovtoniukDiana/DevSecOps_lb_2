# Скопіюйте цей файл у .env і заповніть значення. Файл .env у Git не потрапляє.
# Рядок підключення до бази медичних карток: dragondb://<користувач>:<пароль>@<хост>/<база>
DRAGON_DB_URL=dragondb://app_user:<пароль>@localhost/clinic
# Режим роботи: dev або prod
APP_ENV=dev
# Рівень журналу: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
